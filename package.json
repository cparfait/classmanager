{
  "name": "classmanager-pro",
  "version": "1.1.2",
  "description": "ClassManager Pro - Gestion de placement d'élèves en classe",
  "main": "main.js",
  "author": "Cris Tof",
  "license": "GPL-3.0",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "prebuild": "npm run build:css",
    "build": "electron-builder --win",
    "prebuild-portable": "npm run build:css",
    "build-portable": "electron-builder --win portable",
    "build:css": "tailwindcss -i ./css/tailwind-input.css -o ./css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./css/tailwind-input.css -o ./css/tailwind.css --watch"
  },
  "devDependencies": {
    "electron": "^41.0.4",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^3.4.19"
  },
  "build": {
    "appId": "com.classmanager.pro",
    "productName": "ClassManager Pro",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "icon.ico",
      "cris.jpg",
      "js/**/*",
      "css/tailwind.css",
      "css/app.css",
      "!css/tailwind-input.css",
      "!js/app/classes.js",
      "!**/*.map"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "electronLanguages": ["fr", "en-US"],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerHeaderIcon": "icon.ico",
      "shortcutName": "ClassManager Pro",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "ClassManager-Pro-Portable-${version}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "cparfait",
      "repo": "classmanager"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  }
}
